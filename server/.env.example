# ============================================
# FoodLink AI — Server Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================

# PostgreSQL Connection
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/foodlink

# JWT Secret (change this to a random string in production)
JWT_SECRET=foodlink_dev_jwt_secret_change_me

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development
